<common_patterns>

<pattern id="error-handling">
<code language="typescript">
try {
  const client = createClient({ 
    baseUrl: process.env.CUBBY_API_BASE_URL,
    clientId: process.env.CUBBY_CLIENT_ID,
    clientSecret: process.env.CUBBY_CLIENT_SECRET,
  });
  
  // Check if credentials are valid
  const token = await client.getAccessToken();
  if (!token) {
    throw new Error('invalid cubby credentials');
  }
  
  // Your Cubby operations here
  const results = await client.search({ q: 'test' });
  
} catch (error) {
  console.error('cubby error:', error);
  // Handle error appropriately
}
</code>
</pattern>

<pattern id="device-management">
<code language="typescript">
// For remote access, always check device availability
const { devices } = await client.listDevices();
if (!devices?.length) {
  throw new Error('no cubby devices found. user needs to enroll a device first.');
}

// Use first available device
const deviceId = String(devices[0].id);
client.setDeviceId(deviceId);

// Now all operations use the selected device
const results = await client.search({ q: 'hello' });
</code>
</pattern>

</common_patterns>

